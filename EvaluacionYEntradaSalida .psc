Algoritmo	EvaluacionYEntradaSalida
	Definir a, b Como Entero
	Definir resultadologico Como Logico
	Escribir "Ingrese el valor de A:" // salida
	Leer a                             // entrada
	Escribir "Ingrese el valor de 8:"
	Leer b
	resultadologico <- (a + 5 + 2) > (b / 2)
	Escribir "El resultado de la evaluacion es: ", resultadologico
	
	
FinAlgoritmo
