Algoritmo TiposDeInstrucciones
	// Instrucciones de Declaracion
	Definir x, a, resultado Como Entero
	// 	Instruccion de Entrada
	Leer x
	// Instruccion de Asignacion
	a <- 10
	resultado <- x + a
	// Instruccion Selectiva
	Si resultado > 15 Entonces
